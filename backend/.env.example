PORT=5000
# Option 1: Use full URI (if password has special chars, URL-encode it)
MONGO_URI=

# Option 2: Use separate values (recommended; password will be encoded automatically)
MONGO_USER=
MONGO_PASSWORD=
MONGO_CLUSTER=cluster0.bmh1kne.mongodb.net
MONGO_DB_NAME=fashiongirl

AI_SERVICE_URL=http://localhost:8000
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=admin123
SEED_STAFF_EMAIL=staff@gmail.com
SEED_STAFF_PASSWORD=staff123
SEED_USER_EMAIL=user@gmail.com
SEED_USER_PASSWORD=user123
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=7d

# Ollama Local LLM Configuration
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=mistral-nemo:latest
OLLAMA_TIMEOUT=60000

# Seed Vendor Credentials
SEED_VENDOR_EMAIL=vendor@gmail.com
SEED_VENDOR_PASSWORD=vendor123

# ── PayHere Payment Gateway ─────────────────────────────────────────────────
# Get these from: https://www.payhere.lk/account/settings (Merchant Settings)
# For Sandbox testing: https://sandbox.payhere.lk
PAYHERE_MERCHANT_ID=1234567
PAYHERE_MERCHANT_SECRET=your_merchant_secret_here
PAYHERE_SANDBOX=true

# Public-facing URLs (used to build return_url, cancel_url, notify_url)
# For local dev: use ngrok tunnel for BACKEND_URL so PayHere can reach your notify endpoint
# Example: BACKEND_URL=https://abc123.ngrok-free.app
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

